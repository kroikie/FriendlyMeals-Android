rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Recipe images directory
    match /images/{imageId} {
      // Anyone can view recipe images
      allow read: if true;

      // Only authenticated users (including anonymous auth) can upload images
      // Must be an image format and smaller than 5 MB
      allow create, update: if request.auth != null
                           && request.resource.contentType.matches('image/.*')
                           && request.resource.size < 5 * 1024 * 1024;

      // Only authenticated users can delete images
      allow delete: if request.auth != null;
    }

    // Block access to any other unhandled paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
